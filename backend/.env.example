PORT=5000
NODE_ENV=development

# Local PostgreSQL
DB_USER=postgres
DB_HOST=localhost
DB_DATABASE=logimatch_db
DB_PASSWORD=your_postgres_password_here
DB_PORT=5432

# Production PostgreSQL, for Neon/Render
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:3000

# Resend email API credentials
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=LogiMatch <onboarding@resend.dev>

# Optional price tuning constants
PRICE_DIESEL_PER_LITRE=95
PRICE_FUEL_EFFICIENCY=4
PRICE_KM_PER_DAY=300
PRICE_DRIVER_COST_PER_DAY=1500
