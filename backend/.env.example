# Production PostgreSQL, for Neon/Render
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:3000

# Gmail app password credentials
EMAIL_USER=your.development.email@gmail.com
EMAIL_PASS=your_16_letter_app_password_here

# Optional price tuning constants
PRICE_DIESEL_PER_LITRE=95
PRICE_FUEL_EFFICIENCY=4
PRICE_KM_PER_DAY=300
PRICE_DRIVER_COST_PER_DAY=1500
